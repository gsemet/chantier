@@ -13,13 +13,19 @@ def data_path() -> Path:
     return Path(os.environ.get("SHELF_DATA") or "shelf.json")
 
 
-def load() -> list[dict]:
+def _read() -> list[dict]:
+    """Every record of the file: the items, and a `{"id": n, "deleted": true}` mark for each deleted
+    item, which keeps its id from being given twice."""
     path = data_path()
     if not path.exists():
         return []
     return json.loads(path.read_text(encoding="utf-8"))
 
 
+def load() -> list[dict]:
+    return [i for i in _read() if not i.get("deleted")]
+
+
 def save(items: list[dict]) -> None:
     path = data_path()
     temporary = path.with_name(path.name + ".tmp")
@@ -28,7 +34,7 @@ def save(items: list[dict]) -> None:
 
 
 def add(title: str, url: str = "") -> dict:
-    items = load()
+    items = _read()
     item = {
         "id": max((i["id"] for i in items), default=0) + 1,
         "title": title,
@@ -44,9 +50,20 @@ def get(item_id: int) -> dict | None:
     return next((i for i in load() if i["id"] == item_id), None)
 
 
+def remove(item_id: int) -> bool:
+    """Delete an item; False when there is none. Its id stays taken."""
+    items = _read()
+    for position, item in enumerate(items):
+        if item["id"] == item_id and not item.get("deleted"):
+            items[position] = {"id": item_id, "deleted": True}
+            save(items)
+            return True
+    return False
+
+
 def set_status(item_id: int, status: str) -> dict | None:
-    items = load()
-    item = next((i for i in items if i["id"] == item_id), None)
+    items = _read()
+    item = next((i for i in items if i["id"] == item_id and not i.get("deleted")), None)
     if item is None:
         return None
     item["status"] = status
